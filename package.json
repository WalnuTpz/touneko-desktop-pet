{
  "name": "tangmao-desktop-pet",
  "version": "0.2.0",
  "description": "安静陪伴与卖萌的 Windows 糖猫桌面宠物",
  "main": "src/main.js",
  "author": "Walnut",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/WalnuTpz/touneko-desktop-pet.git"
  },
  "scripts": {
    "prepare:assets": "python scripts/prepare_assets.py --check",
    "prestart": "npm run prepare:assets",
    "start": "electron .",
    "dev": "electron .",
    "start:smoke": "electron . --smoke-test",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/core.js && node --check src/dialogue.js && node --check src/renderer.js",
    "check:assets": "python scripts/prepare_assets.py --check",
    "test": "npm run prepare:assets && node tests/core.test.js && node tests/dialogue.test.js && node tests/manifest.test.js",
    "catalog:assets": "python scripts/render_asset_catalog.py",
    "docs:dialogue": "node scripts/render_dialogue_doc.js",
    "icon": "python scripts/make_icon.py",
    "pack": "electron-builder --dir",
    "predist": "npm run prepare:assets",
    "dist": "npm run icon && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.walnut.tangmao",
    "productName": "糖猫桌宠",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/generated/**/*",
      "scripts/fullscreen-monitor.ps1",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/fullscreen-monitor.ps1"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "糖猫桌宠-${version}.${ext}"
    }
  }
}
